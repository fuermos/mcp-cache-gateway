# mcp-cache-gateway environment configuration
# Copy this file to .env (or ~/.openclaw/state/mcp-cache-gateway.env) and fill in real values.
# .env is git-ignored — DO NOT commit real credentials.
#
# OpenClaw integration: pass these via openclaw.json mcp.servers.<name>.env
# (OpenClaw inherits process env, so source .env before restarting OpenClaw if preferred)

# ============================================================
# PostgreSQL Tier 2 cache
# ============================================================
# Created in dev by: sudo -u postgres psql -c "CREATE USER mcp_cache WITH PASSWORD '...'; CREATE DATABASE mcp_cache OWNER mcp_cache;"
POSTGRES_URL=jdbc:postgresql://localhost:5432/mcp_cache
POSTGRES_USER=mcp_cache
POSTGRES_PASSWORD=replace-with-strong-password

# ============================================================
# Redis Tier 1 cache
# ============================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ============================================================
# Wrong-Notebook upstream (Phase 1 bridge target)
# ============================================================
# Internal-network Next.js deployment of wrong-notebook
WRONGNOTEBOOK_URL=http://localhost:3032
WRONGNOTEBOOK_USER=replace-with-your-email
WRONGNOTEBOOK_PASSWORD=replace-with-your-password

# Optional: reuse existing NextAuth cookie/token files (recommended)
# These files are auto-created by tubi-mcp/wrong-notebook-bridge.js when run once.
# Default locations below match OpenClaw state dir conventions.
WRONGNOTEBOOK_CREDENTIALS_FILE=<OPENCLAW_STATE_DIR>/wrong-notebook-credentials.json
WRONGNOTEBOOK_TOKEN_FILE=<OPENCLAW_STATE_DIR>/wrong-notebook-token.json

# ============================================================
# Tool config (commit-safe paths)
# ============================================================
TOOL_CONFIG_PATH=./examples/tools.yaml
SERVER_REGISTRY_PATH=./examples/servers.yaml